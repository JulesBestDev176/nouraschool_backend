<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- Javadoc : assouplir au démarrage ; durcir progressivement -->
    <suppress checks="MissingJavadocMethod" files=".*[/\\]src[/\\].*\.java"/>
    <suppress checks="MissingJavadocType" files=".*[/\\]src[/\\].*\.java"/>
    <!-- Getter/Setter générés ou triviaux -->
    <suppress checks="MissingJavadocMethod" message="Javadoc.*(getter|setter)"/>
</suppressions>
