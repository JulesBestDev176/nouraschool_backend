# NOURA SCHOOL BACKEND — Variables d'environnement
# Copier vers .env et renseigner les valeurs (ne pas commiter .env)

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=noura_school_db
DB_USERNAME=postgres
DB_PASSWORD=

# --- CORS ---
# Frontend local noura-school-frontend : npm start / ng serve -> http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- JWT ---
JWT_ISSUER=https://noura-school.com
JWT_AUDIENCE=noura-school-api
JWT_ACCESS_TOKEN_LIFESPAN=900

# --- Logs Elasticsearch (optionnel) ---
# Garder false si aucun Elasticsearch n'est créé.
# Les audits restent stockés en PostgreSQL même sans Elasticsearch.
ELASTIC_LOGGING_ENABLED=false
# ELASTIC_HOST=localhost
# ELASTIC_PORT=9200
# ELASTIC_INDEX=noura-audit

# --- Redis (obligatoire : rate limiting, lockout, OTP, tokens reset) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- WhatsApp OTP via whatsapp-web.js gateway ---
WHATSAPP_GATEWAY_ENABLED=false
WHATSAPP_GATEWAY_URL=http://localhost:3100
WHATSAPP_GATEWAY_API_KEY=change-me

# --- SMTP (optionnel au démarrage, nécessaire pour l'envoi réel d'emails) ---
# QUARKUS_MAILER_HOST=smtp.example.com
# QUARKUS_MAILER_PORT=587
# QUARKUS_MAILER_USERNAME=
# QUARKUS_MAILER_PASSWORD=
# QUARKUS_MAILER_FROM=no-reply@noura-school.com
# QUARKUS_MAILER_START_TLS=REQUIRED

# --- S3 / MinIO (optionnel actuellement : StorageService existe mais aucun use case ne l'appelle encore) ---
# AWS_REGION=us-east-1
# AWS_CREDENTIALS_TYPE=static
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=noura-school-files
# S3_ENDPOINT_OVERRIDE=
