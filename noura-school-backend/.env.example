# NOURA SCHOOL BACKEND — Variables d'environnement
# Copier vers .env et renseigner les valeurs (ne pas commiter .env)

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=noura_school_db
DB_USERNAME=postgres
DB_PASSWORD=

# --- JWT ---
JWT_ISSUER=https://noura-school.com
JWT_AUDIENCE=noura-school-api
JWT_ACCESS_TOKEN_LIFESPAN=900

# --- Logs Elasticsearch (optionnel) ---
ELASTIC_LOGGING_ENABLED=false
ELASTIC_HOST=localhost
ELASTIC_PORT=9200
ELASTIC_INDEX=noura-audit

# --- Redis (rate limiting, OTP, tokens reset) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
